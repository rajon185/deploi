APP_NAME=Deploi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=deploi
DB_USERNAME=deploi
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=240
QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="deploi@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Public base URL used to build deploy-webhook URLs (GitHub/GitLab/Bitbucket push hooks).
# Locally this isn't reachable from the internet - use a tunnel (ngrok, cloudflared) to test webhooks.
DEPLOI_WEBHOOK_URL="${APP_URL}"

# SSH connect timeout (seconds) for interactive actions (env editor, stats, log viewer).
DEPLOI_SSH_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"

# Must exceed the longest job (provisioning, ~1h max) or Redis will hand the job to a second worker.
REDIS_QUEUE_RETRY_AFTER=3800
